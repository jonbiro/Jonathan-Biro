{
  "name": "biro-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "VITE_SITE_URL=${VITE_SITE_URL:-https://jonathanbiro.com} vite",
    "build": "VITE_SITE_URL=${VITE_SITE_URL:-https://jonathanbiro.com} vite build",
    "postbuild": "node scripts/generate-seo-files.mjs dist/client && npm run verify:build",
    "lint": "eslint .",
    "preview": "VITE_SITE_URL=${VITE_SITE_URL:-https://jonathanbiro.com} vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "verify:build": "node scripts/verify-build.mjs dist/client"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "vite": "8.2.2",
    "vitest": "^5.0.0"
  }
}
