{
  "name": "biro-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "VITE_SITE_URL=${VITE_SITE_URL:-https://jonathanbiro.com} vite",
    "build": "VITE_SITE_URL=${VITE_SITE_URL:-https://jonathanbiro.com} vite build",
    "postbuild": "node scripts/generate-seo-files.mjs dist/client && npm run verify:build",
    "lint": "eslint .",
    "preview": "VITE_SITE_URL=${VITE_SITE_URL:-https://jonathanbiro.com} vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "verify:build": "node scripts/verify-build.mjs dist/client"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "vite": "8.3.0",
    "vitest": "^5.0.0"
  }
}
